{
  "name": "nextjs-starter",
  "version": "2.2.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "fix": "pnpm i fix-react2shell-next@latest && npx fix-react2shell-next",
    "update:next": "pnpm i next@latest react@latest react-dom@latest @next/env@latest @next/bundle-analyzer@latest @types/react@latest @types/react-dom@latest"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.3.0",
    "@next/env": "^16.3.0",
    "@next/mdx": "^16.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.6",
    "@react-email/render": "^1.1.2",
    "@types/js-cookie": "^3.0.6",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "fix-react2shell-next": "^1.1.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "next-intl": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.4.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "resend": "^6.7.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.38",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.0.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}