# -----------------------------------------------------------------------------
# Site info
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE_DETECTION=false
NEXT_PUBLIC_OPTIMIZED_IMAGES=false

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bot for forms)
# https://developers.cloudflare.com/turnstile/
# Test keys: sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (always pass)
#            2x... (always fail) — create a real site in the dashboard for production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Pricing
# Checkout URL for the Pro plan (payment provider: Lemon Squeezy / Paddle / ...).
# When unset, the Pro CTA falls back to the site root.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PRICING_CHECKOUT_URL=

# -----------------------------------------------------------------------------
# Security
# Secret for signing unsubscribe tokens (use a long random string in production)
# -----------------------------------------------------------------------------
UNSUBSCRIBE_SECRET=

# -----------------------------------------------------------------------------
# Analytics
# Google Analytics: https://analytics.google.com/analytics/web/
# Baidu Tongji: https://tongji.baidu.com/
# Plausible: https://plausible.io/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ID=
NEXT_PUBLIC_BAIDU_TONGJI=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

#------------------------------------------------------------------------
# Ads
# Google Adsense: https://www.google.com/adsense/
#------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

#------------------------------------------------------------------------
# Email Provider
# Supported: resend | cloudflare
#------------------------------------------------------------------------
EMAIL_PROVIDER=resend
ADMIN_EMAIL=

#------------------------------------------------------------------------
# Resend: https://resend.com/
# Required when EMAIL_PROVIDER=resend
#------------------------------------------------------------------------
RESEND_API_KEY=

#------------------------------------------------------------------------
# Cloudflare Email: https://developers.cloudflare.com/email-service/
# Required when EMAIL_PROVIDER=cloudflare
#------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

#------------------------------------------------------------------------
# Upstash: https://upstash.com/
#------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAY_MAX_SUBMISSIONS=
# -----------------------------------------------------------------------------
# Google OAuth (login)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). Authorized JavaScript origins: https://your-domain + http://localhost:3000
# The client id is public (build-time inlined via NEXT_PUBLIC_ prefix).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secret for signing login session cookies (long random string in production).
# On Workers this is a wrangler secret, not an env var. Changing it signs everyone out.
SESSION_SECRET=

# Workers AI chat model override (default: @cf/meta/llama-3.3-70b-instruct-fp8-fast)
AI_MODEL=
